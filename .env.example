# Copie para .env (cp .env.example .env) e troque a senha.
# O .env não vai para o git.
POSTGRES_USER=leilao
# Troque. Use só letras, números e - . _ ~ (a senha entra numa URL de conexão; @ : / # ? % quebram a URL).
# Gerar uma boa:  openssl rand -hex 24
# ATENÇÃO: o banco só lê a senha na PRIMEIRA criação do volume. Trocá-la depois no .env
# não muda a senha do banco já criado (ver "Problemas comuns" no README).
POSTGRES_PASSWORD=troque
POSTGRES_DB=leilao

# Opcional: porta HTTP publicada no host. Padrão 8080, a porta exigida pela organização na VM
# (o redirecionamento externo aponta para a 8080). Não mude na VM; localmente, só se a 8080 estiver ocupada.
# HTTP_PORT=8080

# Local (API/Alembic fora do Docker): descomente e ajuste usuario, senha e banco.
# No Docker, Compose define DATABASE_URL com db:5432 e tem prioridade.
# DATABASE_URL=postgresql+psycopg://leilao:SUA_SENHA@127.0.0.1:5433/leilao

# --- Configuração de domínio (opcional; padrões em backend/app/config.py) ---
# Sessão (RF02): minutos de inatividade até expirar.
# SESSION_IDLE_MINUTES=120
# Nome exclusivo da equipe: o IP público é compartilhado e o navegador mistura cookies
# de portas diferentes do mesmo IP. Não use nomes genéricos como "session".
# SESSION_COOKIE_NAME=afirma_sessao

# Lances e prorrogação (RF14/RF15).
# BID_INCREMENT_CENTS=100
# AUCTION_EXTENSION_WINDOW_SECONDS=60
# AUCTION_EXTENSION_SECONDS=60
# AUCTION_EXTENSION_MAX_SECONDS=600

# Limites de criação (RF05/RF06).
# AUCTION_MIN_START_PRICE=1.00
# AUCTION_MIN_ADVANCE_SECONDS=60
# AUCTION_MAX_ADVANCE_SECONDS=2592000
# AUCTION_MIN_DURATION_SECONDS=60
# AUCTION_MAX_DURATION_SECONDS=604800
# ITEM_NAME_MIN_LENGTH=3
# ITEM_NAME_MAX_LENGTH=100
# ITEM_DESCRIPTION_MIN_LENGTH=10
# ITEM_DESCRIPTION_MAX_LENGTH=2000
# ITEM_MIN_PHOTOS=0
# TEMPORARIO: o padrao esta em 0 ate o F11 (fotos na nuvem); depois volta a 3.
# Para a entrega do Nucleo, manter ao menos 3 fotos e integrar a nuvem.
# ITEM_MAX_PHOTOS=10

# Fotos (RF07): o cartão de fotos usa estes limites ao falar com a nuvem.
# 5242880 bytes = 5 MiB por arquivo.
# PHOTO_MAX_BYTES=5242880
# PHOTO_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

# Categorias separadas por "|" (RF05).
# CATEGORIES=Eletrônicos|Casa e decoração|Moda|Esportes e lazer|Colecionáveis|Livros e mídia|Outros

# Senha das contas criadas por `python -m app.seed` (não é segredo de produção).
# DEMO_PASSWORD=demo1234

